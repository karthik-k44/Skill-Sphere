{
  "name": "skill-sphere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --watch server.ts --exec ts-node src/apps/backend/server.ts\"",
    "server": "nodemon --watch server.ts --exec ts-node src/apps/backend/server.ts",
    "build": "tsc -b && vite build",
