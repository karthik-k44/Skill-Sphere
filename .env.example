# --- Required ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier works).
DBURL=mongodb+srv://<username>:<password>@<cluster>/skill-sphere?retryWrites=true&w=majority
# Long random string used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Optional ---------------------------------------------------------------
PORT=3000
# Separate secret for refresh tokens (defaults to one derived from JWT_SECRET).
JWT_REFRESH_SECRET=
# Comma-separated origins allowed to call the API cross-origin. Leave empty when
# the API and the frontend are served from the same origin (the default setup).
CLIENT_ORIGIN=

# AI provider: any OpenAI-compatible chat completions API.
# Without a key the app still runs; AI features return a clear "not configured" error.
# Free option - Google Gemini (key from https://aistudio.google.com/apikey):
#   AI_ANALYZER_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_ANALYZER_MODEL=gemini-flash-latest
#   AI_ANALYZER_MAX_TOKENS=4000   (Gemini's thinking tokens count against this limit)
AI_ANALYZER_API_KEY=
AI_ANALYZER_API_URL=https://api.openai.com/v1
AI_ANALYZER_MODEL=gpt-4o-mini
AI_ANALYZER_MAX_TOKENS=1500

# Raises the GitHub import rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Shared demo account behind the "Try the demo" button.
DEMO_EMAIL=demo@skillsphere.dev
DEMO_PASSWORD=demo-account-2026

# Frontend (read by Vite at build time). Only needed if the API lives on another origin.
VITE_API_BASE_URL=
